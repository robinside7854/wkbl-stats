{
  "name": "wkbl-stats",
  "version": "0.1.0",
  "private": true,
  "description": "WKBL 팬 스탯 대시보드 (비영리 팬 프로젝트)",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "fetch": "tsx scripts/fetch.ts",
    "process": "tsx scripts/process.ts",
    "report:players": "tsx scripts/report-players.ts",
    "typecheck": "tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.json",
    "test": "tsx tests/parse.test.ts && tsx tests/metrics.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "tailwindcss": "4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "recharts": "3.10.1"
  },
  "overrides": {
    "postcss": "$postcss"
  }
